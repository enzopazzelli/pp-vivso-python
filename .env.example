# API del equipo de Programación (Java Spring Boot)
# Dejar vacío o comentado si no está disponible — el sistema usa datos locales
VIVSO_API_URL=http://localhost:8080

# Base de datos local (no tocar la del equipo Java)
DB_PATH=db/vivso_local.db

# Capa de datos propia (importadores de VISOC)
# Clave para generar los seudónimos de los titulares (mínimo 16 caracteres). NO la subas a git.
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
ANON_SECRET=
# Base de datos real (opcional). Por defecto: db/datos_reales.db
# DATOS_DB_URL=sqlite:///db/datos_reales.db

# Fuente activa para FuenteDeDatos: propia (por defecto) / simulada / json_prueba
# FUENTE=simulada
