.env
db/*.db
# Los CSV son regenerables (python -m synthetic.generate), pero versionamos el
# dataset base para que el deploy en Streamlit Cloud tenga datos sin regenerar.
# Los archivos derivados de los notebooks (procesadas, indicadores) siguen ignorados.
data/*.csv
!data/viviendas_sinteticas.csv
!data/organizaciones.csv
!data/tecnicos.csv
!data/asignaciones.csv
!data/visitas.csv
!data/avance_rubros.csv
data/*.xlsx
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Docs internos de presentación (material de cátedra): se conservan en local
# pero NO se versionan — el repo se comparte con el equipo de Desarrollo.
docs/guia-presentaciones.md
docs/guion-presentacion-hito2.md
docs/prompt-pptx-hito2.md
docs/prompt-pptx-hito3.md
docs/guion-presentacion-hito3.md

# Bitácora y planificación interna del equipo: se conserva en local pero NO se
# versiona — el equipo de Desarrollo y la cátedra consumen README.md y
# docs/para-desarrollo.md en su lugar.
ROADMAP.md

# Informe OG/ONG con datos reales del área (2026-09): el texto libre de GDE trae DNI y
# nombres de familias beneficiarias y reclamantes. Estos archivos NO se versionan; el
# resto de la carpeta (scripts, DECISIONES.md, informe.html) queda a criterio del equipo.
# sitio_web_publico/ es la copia ya depurada por generar_sitio_publico.py.
informe_ong_og_2026/datos_fuente/
informe_ong_og_2026/datos_web.js
informe_ong_og_2026/datos_web.json
informe_ong_og_2026/sitio_web/
